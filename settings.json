{
  "permissions": {
    "allow": [
      "Bash(*)",
      "mcp__firefox-devtools__*",
      "mcp__chrome-devtools__*",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "if": "Bash(codex exec *)",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ooizumiyou/.claude/hooks/codex-exec-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "editorMode": "vim"
}
